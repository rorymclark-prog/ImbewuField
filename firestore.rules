rules_version = '2';

// ImbewuField — Firestore security rules (role-based).
// Profile doc at /profiles/{uid} carries { role, org_id }.
// Staff = ngo | funder | admin. Logs denormalise org_id so staff reads are scoped.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()    { return request.auth != null; }
    function prof()        { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function myRole()      { return signedIn() ? prof().role : 'none'; }
    function myOrg()       { return signedIn() ? prof().org_id : null; }
    function isStaff()     { return myRole() in ['ngo', 'funder', 'admin']; }
    function isMentor()    { return myRole() == 'mentor'; }
    function owns(d)       { return signedIn() && d.profile_id == request.auth.uid; }
    function ownsField(d, field) { return signedIn() && d[field] == request.auth.uid; }
    function sameOrg(d)    { return isStaff() && myOrg() != null && d.org_id == myOrg(); }
    // Stricter than sameOrg(): also admits mentors, and refuses to match two org-less
    // accounts against each other (null == null would otherwise be true).
    function inMyOrg(d)      { return signedIn() && myOrg() != null && d.org_id == myOrg(); }
    function isCourseStaff() { return isMentor() || isStaff(); }

    // ─── Cross-org leak fix (docs/AUDIT-NEEDS-RORY-2026-08-15.md #1) ───────────────────────────
    // isStaff() and, in two places below, isMentor() were bare role checks with no org_id term,
    // so ANY provisioned ngo/funder/admin/mentor account could list or read every OTHER org's
    // farmers. The five helpers below replace every bare isStaff()/isMentor() read branch on
    // profiles (list+get), organizations, designs, course_submissions and survey_responses —
    // mirroring the sameOrg() fix surveys already got, plus two things surveys didn't need:
    // an unconditional admin bypass (Rory's platform role), and a funder->many-NGOs grant.
    function isAdmin() { return myRole() == 'admin'; }
    // Funder -> many-NGOs: a funder's org may read one NGO org's data only if a /grants doc
    // names that exact pairing. Deterministic id `${funder_org_id}_${ngo_org_id}` (see /grants
    // below) — a single exists() check, no query, so this works inside `list` rules too wherever
    // the OTHER branches of the same OR already make the query provably safe.
    function grantedOrg(orgId) {
      return myRole() == 'funder' && myOrg() != null && orgId != null
        && exists(/databases/$(database)/documents/grants/$(myOrg() + '_' + orgId));
    }
    // The ngo/funder half of "same org or granted". Deliberately excludes isMentor() and
    // isAdmin() — every call site below combines this with those separately, so admin stays
    // unconditional and mentor keeps its own, unchanged trust boundary (narrowed to inMyOrg()
    // where it was bare, but never consent-gated — see consentGranted()).
    function staffOrgAccess(d) {
      return (myRole() in ['ngo', 'funder'] && myOrg() != null && d.org_id == myOrg())
        || grantedOrg(d.org_id);
    }
    // Per-farmer opt-in gate (Profile.dataConsent) for the NGO/funder dashboards specifically.
    // NEVER combined with isMentor() or isAdmin() below — a farmer's mentor relationship is the
    // pre-existing, already-consented-by-enrollment path this app has always had, and Rory's own
    // platform-admin access isn't the thing POPIA consent is meant to gate. This only narrows the
    // NEW ngo/funder visibility Rory asked to be consent-gated.
    function consentGranted(profileId) {
      return exists(/databases/$(database)/documents/profiles/$(profileId))
        && get(/databases/$(database)/documents/profiles/$(profileId)).data.get('dataConsent', null) != null
        && get(/databases/$(database)/documents/profiles/$(profileId)).data.dataConsent.granted == true;
    }
    // isAdmin() bypass + staffOrgAccess(d), gated by the farmer's consent — the shape every
    // farmer-identifying collection's staff branch below uses. NOT applied to isMentor(), by
    // design (see consentGranted() above).
    function staffConsentedAccess(d) {
      return isAdmin() || (staffOrgAccess(d) && consentGranted(d.profile_id));
    }
    // Feature-flag scaffold for the NGO dashboard v2 surfaces (admin panel, consent-aware
    // dashboard wiring, aggregate reporting) built on top of this fix — same on/off pattern as
    // communityOn()/rendersOn() below. Not wired to any match block yet: phases 2-4 gate their
    // new UI/collections on this once they exist. Toggle by writing { enabled: true } to
    // app_config/ngo_dashboard_v2 via the Firebase console or an Admin-SDK script.
    function ngoDashboardV2On() {
      return exists(/databases/$(database)/documents/app_config/ngo_dashboard_v2)
        && get(/databases/$(database)/documents/app_config/ngo_dashboard_v2).data.enabled == true;
    }

    // Backend kill switch for the community layer — evaluated ONLY inside the
    // community_* match blocks below, so it never adds a read to unrelated
    // collections. Doc absent or enabled != true => every community read/write
    // is denied here regardless of the client env flag (NEXT_PUBLIC_COMMUNITY_ENABLED).
    // Toggle by writing { enabled: true|false } to app_config/community via the
    // Firebase console or an Admin-SDK script (this doc has no client-facing rule).
    function communityOn() {
      return exists(/databases/$(database)/documents/app_config/community)
        && get(/databases/$(database)/documents/app_config/community).data.enabled == true;
    }

    match /profiles/{uid} {
      // `get` and `list` are split deliberately. A LIST is authorised once, up front, before
      // any document has been read, so the per-document `uid == request.auth.uid` term below
      // cannot be proven and drags the whole OR to false — which is why the mentor dashboard
      // could never load a cohort and always showed its empty state. Querying the directory
      // is a staff/mentor capability and nothing else, so `list` says exactly that.
      allow get:    if signedIn() && (
        uid == request.auth.uid ||
        isAdmin() ||
        (isMentor() && inMyOrg(resource.data)) ||
        staffOrgAccess(resource.data)
      );
      allow list:   if signedIn() && (
        isAdmin() ||
        (isMentor() && inMyOrg(resource.data)) ||
        staffOrgAccess(resource.data)
      );
      // Self-service signup may pick one of the offered roles, but NEVER admin, and may
      // never self-assign an org (that grants cross-tenant access). org_id is admin-driven.
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.role in ['farmer', 'student']
        && (!('org_id' in request.resource.data) || request.resource.data.org_id == null);
      // role and org_id are IMMUTABLE from the client — pin them to the existing values so a
      // user can edit name/photo/language but can never self-promote to admin or spoof an org.
      // Promotion/org assignment must go through a trusted Admin-SDK backend or custom claims.
      allow update: if signedIn() && uid == request.auth.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.org_id == resource.data.org_id;
    }

    match /organizations/{id} { allow read: if signedIn() && (id == myOrg() || isAdmin() || grantedOrg(id)); }
    match /programmes/{id}    { allow read: if signedIn() && resource.data.org_id == myOrg(); }

    match /gardens/{gid} {
      // isAdmin()/staffOrgAccess() supersede the older sameOrg() branch — Phase 4 of the
      // NGO/funder dashboard build needs a platform admin and a funder-with-a-grant to read a
      // garden doc too, matching the idiom `designs` already uses. sameOrg() is subsumed by
      // staffOrgAccess() (same-org staff is its first branch) but is harmless to leave implied.
      allow read: if signedIn() && (
        isAdmin() ||
        staffOrgAccess(resource.data) ||
        resource.data.supervisor_id == request.auth.uid ||
        isMentor() ||
        exists(/databases/$(database)/documents/gardens/$(gid)/members/$(request.auth.uid))
      );
      allow write: if signedIn() && (isStaff() || resource.data.supervisor_id == request.auth.uid);

      match /members/{pid} {
        // Scope to the parent garden — same-org staff, a granted funder, admin, the supervisor,
        // a mentor, or the member themselves. Prevents cross-org enumeration of every garden's
        // participants.
        allow read: if signedIn() && (
          isAdmin() ||
          staffOrgAccess(get(/databases/$(database)/documents/gardens/$(gid)).data) ||
          get(/databases/$(database)/documents/gardens/$(gid)).data.supervisor_id == request.auth.uid ||
          isMentor() ||
          pid == request.auth.uid
        );
        allow write: if signedIn() && (isStaff() ||
          get(/databases/$(database)/documents/gardens/$(gid)).data.supervisor_id == request.auth.uid);
      }
    }
    // NOTE: the blanket `match /{path=**}/members/{pid}` recursive read was removed — it
    // exposed every garden's member list to any signed-in user. listGardeners reads members
    // by explicit garden id, which the scoped per-garden rule above already permits.

    match /production_logs/{id} {
      allow read:   if owns(resource.data) || staffConsentedAccess(resource.data) || (isMentor() && inMyOrg(resource.data));
      allow create: if signedIn()
        && request.resource.data.profile_id == request.auth.uid
        && request.resource.data.kg is number && request.resource.data.kg > 0
        && request.resource.data.crop is string && request.resource.data.crop.size() > 0;
      // UPDATE MUST PIN OWNERSHIP AND RE-VALIDATE. `owns(resource.data)` only inspects the document
      // as it was BEFORE the write, so nothing stopped a farmer re-pointing their own row at
      // somebody else: updateDoc(myRow, { profile_id: '<victim uid>', amount: 90000 }) landed in the
      // victim's ledger, because /finances queries where('profile_id','==',uid). The create-time
      // checks were not re-applied either, so a negative amount persisted and subtracted from their
      // income. This file already pins exactly these fields on /profiles, /course_enrollments and
      // /board_posts — these three money collections were the outliers. Predicates below are copied
      // verbatim from this collection's own create rule.
      allow update: if owns(resource.data)
        && request.resource.data.profile_id == resource.data.profile_id
        && request.resource.data.org_id == resource.data.org_id
        && request.resource.data.kg is number && request.resource.data.kg > 0
        && request.resource.data.crop is string && request.resource.data.crop.size() > 0;
      allow delete: if owns(resource.data);
    }

    match /sales_logs/{id} {
      allow read:   if owns(resource.data) || staffConsentedAccess(resource.data) || (isMentor() && inMyOrg(resource.data));
      allow create: if signedIn()
        && request.resource.data.profile_id == request.auth.uid
        && request.resource.data.kg is number && request.resource.data.kg > 0
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && request.resource.data.crop is string && request.resource.data.crop.size() > 0;
      // UPDATE MUST PIN OWNERSHIP AND RE-VALIDATE. `owns(resource.data)` only inspects the document
      // as it was BEFORE the write, so nothing stopped a farmer re-pointing their own row at
      // somebody else: updateDoc(myRow, { profile_id: '<victim uid>', amount: 90000 }) landed in the
      // victim's ledger, because /finances queries where('profile_id','==',uid). The create-time
      // checks were not re-applied either, so a negative amount persisted and subtracted from their
      // income. This file already pins exactly these fields on /profiles, /course_enrollments and
      // /board_posts — these three money collections were the outliers. Predicates below are copied
      // verbatim from this collection's own create rule.
      allow update: if owns(resource.data)
        && request.resource.data.profile_id == resource.data.profile_id
        && request.resource.data.org_id == resource.data.org_id
        && request.resource.data.kg is number && request.resource.data.kg > 0
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && request.resource.data.crop is string && request.resource.data.crop.size() > 0;
      allow delete: if owns(resource.data);
    }

    match /expense_logs/{id} {
      allow read:   if owns(resource.data) || staffConsentedAccess(resource.data) || (isMentor() && inMyOrg(resource.data));
      allow create: if signedIn()
        && request.resource.data.profile_id == request.auth.uid
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && request.resource.data.item is string && request.resource.data.item.size() > 0;
      // UPDATE MUST PIN OWNERSHIP AND RE-VALIDATE. `owns(resource.data)` only inspects the document
      // as it was BEFORE the write, so nothing stopped a farmer re-pointing their own row at
      // somebody else: updateDoc(myRow, { profile_id: '<victim uid>', amount: 90000 }) landed in the
      // victim's ledger, because /finances queries where('profile_id','==',uid). The create-time
      // checks were not re-applied either, so a negative amount persisted and subtracted from their
      // income. This file already pins exactly these fields on /profiles, /course_enrollments and
      // /board_posts — these three money collections were the outliers. Predicates below are copied
      // verbatim from this collection's own create rule.
      allow update: if owns(resource.data)
        && request.resource.data.profile_id == resource.data.profile_id
        && request.resource.data.org_id == resource.data.org_id
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && request.resource.data.item is string && request.resource.data.item.size() > 0;
      allow delete: if owns(resource.data);
    }

    match /designs/{id} {
      allow read:   if ownsField(resource.data, 'owner_id') || ownsField(resource.data, 'shared_with') || isAdmin() || staffOrgAccess(resource.data);
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid
        && request.resource.data.org_id == myOrg();
      allow update: if ownsField(resource.data, 'owner_id') && request.resource.data.org_id == resource.data.org_id;
      allow delete: if ownsField(resource.data, 'owner_id');
    }

    match /reports/{id} {
      allow read:   if ownsField(resource.data, 'owner_id') || sameOrg(resource.data) || (isMentor() && inMyOrg(resource.data));
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if ownsField(resource.data, 'owner_id');
    }

    match /saved_places/{id} {
      allow read, delete: if owns(resource.data);
      allow create: if signedIn() && request.resource.data.profile_id == request.auth.uid;
    }

    match /course_progress/{id} {
      allow read:  if owns(resource.data) || isAdmin() || (isMentor() && inMyOrg(resource.data)) || staffConsentedAccess(resource.data);
      allow write: if signedIn()
        && request.resource.data.profile_id == request.auth.uid
        && request.resource.data.org_id == myOrg()
        && request.resource.data.module is string
        && request.resource.data.done is bool;
    }

    // Enrollment and assignments are MENTOR-OWNED. The learner owns their own
    // course_progress tick (above) and nothing else here: they cannot enrol themselves onto
    // a programme, cannot set their own deadlines, and cannot delete an assignment they
    // would rather not do. Every rule below also requires a non-null org, so two org-less
    // accounts can never see each other through a null == null match.

    match /course_enrollments/{id} {
      allow read: if owns(resource.data) || (isCourseStaff() && inMyOrg(resource.data));
      allow create: if isCourseStaff()
        && inMyOrg(request.resource.data)
        && request.resource.data.enrolled_by == request.auth.uid
        && request.resource.data.profile_id is string
        && request.resource.data.track is string
        && request.resource.data.status in ['invited', 'active', 'paused', 'completed', 'withdrawn'];
      // profile_id and org_id are pinned: an enrollment can never be re-pointed at a
      // different learner or walked across to another org by an update.
      allow update: if isCourseStaff()
        && inMyOrg(resource.data)
        && request.resource.data.profile_id == resource.data.profile_id
        && request.resource.data.org_id == resource.data.org_id
        && request.resource.data.status in ['invited', 'active', 'paused', 'completed', 'withdrawn'];
      allow delete: if isCourseStaff() && inMyOrg(resource.data);
    }

    match /course_assignments/{id} {
      allow read: if owns(resource.data) || (isCourseStaff() && inMyOrg(resource.data));
      allow create, update: if isCourseStaff()
        && inMyOrg(request.resource.data)
        && request.resource.data.assigned_by == request.auth.uid
        && request.resource.data.profile_id is string
        && request.resource.data.module is string
        && (request.resource.data.due_at == null || request.resource.data.due_at is string);
      allow delete: if isCourseStaff() && inMyOrg(resource.data);
    }

    // Course-portal submission evidence (photo + optional voice, plus self-check ticks) —
    // gating for what this unlocks lives in lib/course-gating.ts (client-side; these rules are
    // the actual boundary). Deterministic id `${profile_id}_${module}`, same upsert pattern as
    // course_progress and course_assignments — resubmitting a module overwrites its evidence
    // rather than growing a duplicate row. Read parity is with course_progress specifically — a
    // mentor/staff member who can already see a module is done can see the evidence that
    // unlocked it, which is the same trust boundary, not a bigger one (now org-scoped +
    // consent-gated for ngo/funder, see docs/AUDIT-NEEDS-RORY-2026-08-15.md #1 — it previously
    // had no org_id field at all and this bare isStaff()/isMentor() reached every org). Writes
    // are learner-only; mentors/staff never write a submission on a learner's behalf.
    match /course_submissions/{id} {
      allow read: if owns(resource.data) || isAdmin() || (isMentor() && inMyOrg(resource.data)) || staffConsentedAccess(resource.data);
      allow create, update: if signedIn()
        && request.resource.data.profile_id == request.auth.uid
        && request.resource.data.org_id == myOrg()
        && request.resource.data.module is string
        && request.resource.data.submitted_at is string
        && request.resource.data.self_check is list
        && (!('photo_path' in request.resource.data) || request.resource.data.photo_path == null || request.resource.data.photo_path is string)
        && (!('voice_path' in request.resource.data) || request.resource.data.voice_path == null || request.resource.data.voice_path is string);
      allow delete: if false; // evidence is append/overwrite only — no client-side deletion
    }

    match /mentor_visits/{id} {
      allow read:   if signedIn() && (
        resource.data.mentor_id == request.auth.uid ||
        resource.data.trainee_id == request.auth.uid ||
        isStaff()
      );
      allow create: if signedIn()
        && isMentor()
        && request.resource.data.mentor_id == request.auth.uid
        && request.resource.data.notes is string;
      allow update, delete: if signedIn() && resource.data.mentor_id == request.auth.uid;
    }

    match /surveys/{id} {
      // sameOrg (not bare isStaff) so a staff member can't read another org's surveys by id.
      // createSurvey stamps org_id and listSurveys queries by org, so this matches the app.
      allow read:   if signedIn() && (sameOrg(resource.data) || resource.data.created_by == request.auth.uid);
      allow create: if signedIn() && isStaff() && request.resource.data.created_by == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.created_by == request.auth.uid;
    }

    match /survey_responses/{id} {
      // Org-scoped (not consent-gated — survey_responses isn't in the consent list Rory asked
      // for; a farmer answering an org's own survey is a different trust relationship than the
      // ambient production/sales/course visibility consent gates). It previously had no org_id
      // field at all and bare isStaff() reached every org — see
      // docs/AUDIT-NEEDS-RORY-2026-08-15.md #1.
      allow read:   if signedIn() && (resource.data.profile_id == request.auth.uid || isAdmin() || staffOrgAccess(resource.data));
      allow create: if signedIn() && request.resource.data.profile_id == request.auth.uid
        && request.resource.data.org_id == myOrg();
    }

    // Funder -> NGO grant: admin-SDK-write-only (phase 2's platform admin panel), so client
    // writes are always denied here regardless of role. Deterministic id
    // `${funder_org_id}_${ngo_org_id}` — see grantedOrg() above and the Grant type in
    // lib/db/types.ts. Reads are scoped to the two orgs the grant names, plus admin.
    match /grants/{id} {
      allow read: if signedIn() && (
        isAdmin() ||
        (myOrg() != null && (resource.data.funder_org_id == myOrg() || resource.data.ngo_org_id == myOrg()))
      );
      allow write: if false;
    }

    // Per-user map data (farm shapes, saved places, water points) — cross-device sync.
    match /user_map_data/{uid}/data/{doc} {
      allow read, write: if request.auth != null && uid == request.auth.uid;
    }

    match /shared_sites/{code} {
      // GET, NOT READ. `read` covers both `get` and `list`, so `allow read: if true` let anyone —
      // unauthenticated — call getDocs(collection('shared_sites')) and walk out with every farm
      // design anyone has ever shared, geojson and all. The six-character code is the capability:
      // it is meant to be unguessable, and an enumerable collection makes guessing unnecessary.
      // tests/firestore-rules.test.ts has asserted this since it was written; the assertion had
      // never once executed, because no workflow ran `test:rules`.
      allow get:  if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.geojson is map;
      allow update, delete: if false;
    }

    // ─── Community layer (opt-in profiles, trade board, 1:1 messaging) ──────
    // All additive/new collections behind the NEXT_PUBLIC_COMMUNITY_ENABLED
    // kill switch on the client — these rules are the backstop regardless.
    // Deliberately separate from /profiles: nothing here ever loosens the
    // existing profiles/gardens/logs isolation above.

    match /community_profiles/{uid} {
      // Doc existing == the farmer opted in. Only public-safe, farmer-typed
      // fields are ever written here (coarse lat/lon computed client-side).
      allow read:   if communityOn() && signedIn();
      allow create, update: if communityOn() && signedIn() && uid == request.auth.uid
        && request.resource.data.uid == uid;
      allow delete: if communityOn() && signedIn() && uid == request.auth.uid;
    }

    match /board_posts/{id} {
      allow read:   if communityOn() && signedIn();
      allow create: if communityOn() && signedIn() && request.resource.data.owner_id == request.auth.uid;
      // owner_id is immutable on update — a farmer can edit their own post but
      // can never reassign authorship to another farmer's uid.
      allow update: if communityOn() && signedIn() && resource.data.owner_id == request.auth.uid
        && request.resource.data.owner_id == resource.data.owner_id;
      allow delete: if communityOn() && signedIn() && resource.data.owner_id == request.auth.uid;
    }

    match /message_threads/{threadId} {
      allow read:   if communityOn() && signedIn() && request.auth.uid in resource.data.participants;
      allow create: if communityOn() && signedIn() && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      // Membership AND participant_names are immutable after creation — only
      // last_message/last_message_at may change (set when a message is sent).
      // Otherwise either participant could rewrite the other's denormalised
      // display name or forge the message preview.
      allow update: if communityOn() && signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.participant_names == resource.data.participant_names;

      match /messages/{msgId} {
        allow read:   if communityOn() && signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/message_threads/$(threadId)).data.participants;
        allow create: if communityOn() && signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/message_threads/$(threadId)).data.participants
          && request.resource.data.sender_id == request.auth.uid;
        allow update, delete: if false; // messages are immutable, no edit/unsend in v1
      }
    }

    match /community_reports/{id} {
      allow create: if communityOn() && signedIn() && request.resource.data.reporter_id == request.auth.uid;
      allow read:   if communityOn() && signedIn() && myRole() == 'admin';
      allow update, delete: if false;
    }

    // Kill switch for the AI-render pipeline — same pattern as communityOn(). Doc absent or
    // enabled != true => nobody can enqueue a render (one console toggle stops ALL OpenAI spend).
    // Create app_config/renders = { enabled: true } to turn the pipeline on.
    function rendersOn() {
      return exists(/databases/$(database)/documents/app_config/renders)
        && get(/databases/$(database)/documents/app_config/renders).data.enabled == true;
    }

    // Background AI-render jobs (worker: functions/src/index.ts). The browser CREATES a job for
    // itself (uid must match, must start 'queued') and READS its own job to stream progress. Only
    // the Admin-SDK worker mutates a job (it bypasses these rules), so update/delete are closed to
    // the client — a user can never rewrite another user's job or forge a 'complete' state. The
    // WORKER is the real enforcement boundary (quota, path-scoping, prompt clamp); these rules are
    // the cheap first gate: ownership, the kill switch, and the sheet-count cap.
    match /render_jobs/{jobId} {
      allow read:   if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && rendersOn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'queued'
        && request.resource.data.sheets.size() <= 5;
      allow update, delete: if false;
    }

    // Per-user daily render quota, written ONLY by the Admin-SDK worker. Readable by the owner so
    // the UI can show "N of your daily renders left"; never client-writable.
    match /render_usage/{docId} {
      allow read:  if signedIn() && docId.split('_')[0] == request.auth.uid;
      allow write: if false;
    }
  }
}
