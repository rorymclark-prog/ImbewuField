rules_version = '2';

// ImbewuField — Firebase Storage rules. Photos (produce/grower/garden) are
// publicly readable (so they show in reports/dashboards) and writable by any
// signed-in user under their own folder.
service firebase.storage {
  match /b/{bucket}/o {
    // Course-portal submission evidence (photo + optional voice note per module). Private —
    // unlike /photos/** above, NOT world-readable: scoped to the learner who submitted it plus
    // the mentors/staff who can already read the matching course_submissions/course_progress
    // Firestore docs (see firestore.rules). Cross-service Firestore lookup, same documented
    // pattern Firebase Storage rules support for gating storage reads on a Firestore-held role —
    // this repo has no prior example of it, so treat as unverified until deploy-checked
    // (`firebase deploy --only storage --dry-run` or the emulator) before relying on it.
    function isCourseStaffOrMentor() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/profiles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role in ['mentor', 'ngo', 'funder', 'admin'];
    }
    match /course_submissions/{uid}/{moduleId}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || isCourseStaffOrMentor());
      allow create, update: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /photos/{folder}/{uid}/{file=**} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /photos/{allPaths=**} {
      allow read: if true;
    }

    // AI-render job images, scoped per user. The browser writes each sheet's INPUT composite and
    // reads its OUTPUT; the Cloud Function worker writes outputs via the Admin SDK (bypasses these
    // rules). Private to the owner — not world-readable like photos.
    match /renders/{uid}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.size < 12 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      // request.resource is null for deletes, so evaluating its size/content type makes the
      // enqueue rollback fail and strands input/mask objects. Deletion stays owner-scoped.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
