rules_version = '2';

// ImbewuField — Firebase Storage rules. Photos (produce/grower/garden) are
// publicly readable (so they show in reports/dashboards) and writable by any
// signed-in user under their own folder.
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{folder}/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /photos/{allPaths=**} {
      allow read: if true;
    }

    // AI-render job images, scoped per user. The browser writes each sheet's INPUT composite and
    // reads its OUTPUT; the Cloud Function worker writes outputs via the Admin SDK (bypasses these
    // rules). Private to the owner — not world-readable like photos.
    match /renders/{uid}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
