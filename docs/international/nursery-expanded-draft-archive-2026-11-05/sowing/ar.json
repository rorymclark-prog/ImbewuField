    {
      "key": "nurserySowing.message.11",
      "english": "Actual observed day",
      "messageSha256": "695ed5ae7ff666916dfe84fdb0088338bd167792171e89b313d1adbcb8041048",
      "translation": "اليوم الملاحظ الفعلي"
    },
    {
      "key": "nurserySowing.message.12",
      "english": "What you observed",
      "messageSha256": "9714203997dd1813c87bf6d61abf6c0d9caed3c1466df7e362291bff2fbb798d",
      "translation": "ما لاحظته"
