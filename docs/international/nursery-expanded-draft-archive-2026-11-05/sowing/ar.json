      "messageSha256": "45d4fb68fda12bdf0bcc6c828f507c3523b655997434297ef3bb9c60ca9a49b4",
      "translation": "الصواني الفعلية المستخدمة (اختياري)"
    },
    {
      "key": "nurserySowing.message.14",
      "english": "Count whole physical trays used, including partly filled trays. Leave blank for unknown or other containers. An entered 0 means zero trays.",
      "messageSha256": "64c48afbdb5d7c6868e56b957473f079db5c22816c0c6467a4bce3bb85bde5ee",
      "translation": "احسب الصواني الفعلية الكاملة المستخدمة، بما في ذلك الصواني الممتلئة جزئيا. اتركه فارغا للحاويات غير المعروفة أو الأخرى. إدخال 0 يعني صفر صينية."
    },
    {
      "key": "nurserySowing.message.15",
      "english": "I confirm this day, note and tray count describe what I observed.",
      "messageSha256": "f385bd12e520b7edb1d46f29998b4c20d06e32b755d7a1d8c2096a9e2df930af",
      "translation": "أؤكد أن هذا اليوم والملاحظة وعدد الصواني تصف ما لاحظته."
    },
    {
      "key": "nurserySowing.message.16",
      "english": "Recording observed sowing…",
      "messageSha256": "9a5912d95a801e8a47773faf8364ce609b33cb578c0d5a831e498c17baf5f006",
      "translation": "جار تسجيل البذر الملاحظ…"
    },
    {
      "key": "nurserySowing.message.17",
      "english": "Save nursery sowing observation",
      "messageSha256": "94c877a7fad35462f9c3ec3543803f968c60d0d7146d0ab937da680d4d818c60",
      "translation": "حفظ ملاحظة بذر المشتل"
    },
    {
      "key": "nurserySowing.message.18",
      "english": "Inspect the journal before recording again. There is no automatic retry. After reviewing the journal and checking saved batches, start a new observation only if needed.",
      "messageSha256": "d0b4ceb65699aefb11b44cf5d161f01417f8874b629cd8450ea83f9e6b6a3eae",
      "translation": "تفقد السجل قبل التسجيل مرة أخرى. لا توجد إعادة محاولة تلقائية. بعد مراجعة السجل والتحقق من الدفعات المحفوظة، ابدأ ملاحظة جديدة فقط عند الحاجة."
    },
    {
