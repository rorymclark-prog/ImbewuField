      "messageSha256": "fcc41dd8ecbc68eb05c9f3fcdd5ed53b2c3bc73f6560fce20d888b0c9b805641",
      "translation": "تسجيل بذر مشتل آخر"
    },
    {
      "key": "nurserySowing.message.21",
