  "messages": [
    {
      "key": "nurserySowing.message.01",
      "english": "The journal outcome could not be confirmed. Inspect the journal before recording this observation again.",
      "messageSha256": "ed1a727605b8c1978268ac32d7568ef9d80f6fc09c039abd7105664bebdeebbb",
      "translation": "تعذر تأكيد نتيجة السجل. تفقد السجل قبل تسجيل هذه الملاحظة مرة أخرى."
    },
    {
      "key": "nurserySowing.message.02",
      "english": "This observed-sowing form belongs to an earlier checked batch. Check saved nursery batches before opening a new observation.",
      "messageSha256": "eabf14576daab6e350e98644ecffd962dbe342d6b9103b40985e061d2a68b55c",
      "translation": "ينتمي نموذج البذر الملاحظ هذا إلى دفعة سابقة تم فحصها. تحقق من دفعات المشتل المحفوظة قبل فتح ملاحظة جديدة."
    },
    {
      "key": "nurserySowing.message.03",
      "english": "Record observed nursery sowing",
      "messageSha256": "31e649db516ea20d26998bedc6bb2a913f517cfc65dbc3c2af3c9ce1df070bec",
      "translation": "تسجيل بذر المشتل الملاحظ"
    },
    {
      "key": "nurserySowing.message.04",
      "english": "Record actual nursery sowing",
      "messageSha256": "de534391d54a77e99a833770f30d0212f7d58b59fe4c2ebc852e47269103f4da",
      "translation": "تسجيل بذر المشتل الفعلي"
    },
    {
      "key": "nurserySowing.message.05",
      "english": "Enter what you observed, separately from the planned dates and quantities. This journal note does not change stock, tasks or nursery estimates.",
      "messageSha256": "a05cf1b09e9d93292e3f3efe1df975eccc0b3ae800863a7c5b848a0cff6df2cb",
      "translation": "أدخل ما لاحظته، بشكل منفصل عن التواريخ والكميات المخططة. لا تغير هذه الملاحظة في السجل المخزون أو المهام أو تقديرات المشتل."
    },
    {
      "key": "nurserySowing.message.06",
      "english": "DEMO — this observation stays in the sample session.",
      "messageSha256": "885bc7d92ee53522fb5a9912b6f47c8957ceec127fea6e5921b51f3901debe43",
      "translation": "DEMO — تبقى هذه الملاحظة في جلسة العينة."
    },
    {
      "key": "nurserySowing.message.07",
      "english": "Checked labels to snapshot with this observation; they do not verify seed identity:",
      "messageSha256": "bff0cc6684d557846d286ae704a2ca4309a5efbed0183a8b46d4b9fec18c3e6a",
      "translation": "الملصقات التي تم فحصها لتصويرها مع هذه الملاحظة؛ وهي لا تؤكد هوية البذور:"
    },
    {
      "key": "nurserySowing.message.08",
      "english": "Seed-lot reference",
      "messageSha256": "c0097ff0629eec6bcf86365c96e8574efea05b0d0630f63916af2cf4ac58158d",
      "translation": "مرجع دفعة البذور"
