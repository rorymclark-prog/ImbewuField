      "key": "nurseryProgress.message.22",
      "english": "Plants observed",
      "messageSha256": "aa8a5badb61978af5d22dd73345f775dc4a42ea36308bd1ec797ad07a23237dc",
      "translation": "अवलोकित पौधे"
