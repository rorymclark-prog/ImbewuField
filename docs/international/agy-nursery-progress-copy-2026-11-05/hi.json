  "messages": [
    {
      "key": "nurseryProgress.message.01",
      "english": "This nursery-count form belongs to an earlier checked batch. Check saved nursery batches before opening a new observation.",
      "messageSha256": "b3d63e90e7c6113cc7fdbbdb1ce28ea3dc565e8c6af8568e547ef74a48d9b14b",
      "translation": "यह नर्सरी-गिनती प्रपत्र पहले के जाँचे गए बैच से संबंधित है। नया अवलोकन खोलने से पहले सहेजे गए नर्सरी बैचों की जाँच करें।"
    },
    {
      "key": "nurseryProgress.message.02",
      "english": "Record an observed nursery plant count",
      "messageSha256": "5d7553d59425793d39f186b723fc4ed3dcfe791ac70eb51963e56e57b459a701",
      "translation": "अवलोकित नर्सरी पौध गिनती दर्ज करें"
    },
    {
      "key": "nurseryProgress.message.03",
      "english": "Enter your observed plant count separately from planned quantities. Repeated observations are not added together as stock, and a checked subset does not establish a whole-batch count.",
      "messageSha256": "952c69c5b9a67ed1709f4775e081c24474bf97e6ee754e3ecf524883d21778cf",
      "translation": "योजनाबद्ध मात्राओं से अलग अपनी अवलोकित पौध गिनती दर्ज करें। बार-बार किए गए अवलोकनों को स्टॉक के रूप में एक साथ नहीं जोड़ा जाता है, और जाँचा गया उपसमूह पूरे बैच की गिनती स्थापित नहीं करता है।"
    },
    {
      "key": "nurseryProgress.message.04",
      "english": "Plants you observed",
      "messageSha256": "98ffc3f26ac1dfa02616b9de00c5e84943f55e0a2e2f5d591c1f76b0d6a145b5",
      "translation": "पौधे जो आपने देखे"
    },
    {
      "key": "nurseryProgress.message.05",
      "english": "Enter a whole count. An explicitly entered 0 is zero; a blank field is not a count.",
      "messageSha256": "921c0851b058d2e2cbcb6ab914c53828fcfe2fb158a60199c2e46cd6f57381a7",
      "translation": "बिना भिन्न के पूर्ण संख्या में गिनती दर्ज करें। स्पष्ट रूप से दर्ज 0 शून्य है; खाली फ़ील्ड कोई गिनती नहीं है।"
    },
    {
      "key": "nurseryProgress.message.06",
      "english": "Your assessment",
      "messageSha256": "a740ab409a6c02198962aa1ee6a2d2c4e2df4ec1f575b1d27c4d8cef7d9d4701",
      "translation": "आपका आकलन"
    },
    {
