      "messageSha256": "8459f387bef3153b0598e3369c91e7dd0c296c4d68c9aebc7bff2516e4d45058",
      "translation": "उत्पादक आकलन"
    },
    {
      "key": "nurseryProgress.message.24",
      "english": "Ready — grower assessment",
      "messageSha256": "5bfed112f20c44a508eb90adb64c857c4c11f1cfe95271da2f1b7f7011770343",
      "translation": "तैयार — उत्पादक आकलन"
    },
    {
      "key": "nurseryProgress.message.25",
