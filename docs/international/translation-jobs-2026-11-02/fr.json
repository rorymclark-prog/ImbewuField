      }
    },
    {
      "key": "NurseryPlanPanel.015",
      "sourceEnglish": "2. Your trays and containers ·",
      "sourceSha256": "bfba947d8f3dcd9cbc2dee87a64431459c4aab4d6b6ebff84ec96b12af8e2806",
      "text": "2. Vos plaques et conteneurs ·",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "NurseryPlanPanel.016",
      "sourceEnglish": "Give each tray type its own name. Outer width and length determine its bench footprint. Owned stock is the number allocated to this plan, not a count of trays currently empty.",
      "sourceSha256": "7f4ebfa70a70b7685273ca1db6f8c6bfda79d1901a805ca5c5729ab190c6a7e5",
      "text": "Donnez un nom propre à chaque type de plaque. La largeur et la longueur extérieures déterminent son emprise sur les tables de culture. Le stock possédé correspond au nombre alloué à ce plan, et non à un décompte des plaques actuellement vides.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "NurseryPlanPanel.017",
      "sourceEnglish": "cells",
      "sourceSha256": "57104c57fbe0d1c944620f06ca6f5f1e26fc87025ad368e9327743b8975e4d49",
      "text": "alvéoles",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "NurseryPlanPanel.018",
      "sourceEnglish": "Outer size:",
      "sourceSha256": "20613999ecf51d72274dffcbcd8183a20c0f174763077ea661e82076e3c3dda3",
      "text": "Dimensions extérieures :",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "NurseryPlanPanel.019",
      "sourceEnglish": ". Owned:",
      "sourceSha256": "a5c188b7e4ce25b416df60a2bbe8f4f80bf70b18219561bf0fcf547efe2540b5",
      "text": ". Possédé :",
      "review": {
        "status": "unreviewed"
      }
    },
    {
