    {
      "key": "WorkspaceReferencePanel.001",
      "sourceEnglish": "Confirm the reference basis for this unmapped workspace first.",
      "sourceSha256": "01eb6d99602efd3d09e74f30466931652751436b23ccc7f37a652d6ebd8a9bfd",
      "text": "Confirmez d’abord la base de référence pour cet espace de travail non cartographié.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "WorkspaceReferencePanel.002",
      "sourceEnglish": "The reference choice could not be saved. Please try again; your previous saved choice remains in place.",
      "sourceSha256": "cd823808105a579e614c00c2e0f530573f6ab1f2b2a6d5d4a5e38a060f486850",
      "text": "Impossible d’enregistrer le choix de référence. Veuillez réessayer ; votre choix enregistré précédent reste inchangé.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "WorkspaceReferencePanel.003",
      "sourceEnglish": "Reference choice saved with this device’s crop plan. This does not confirm a farm country or local farming approval.",
      "sourceSha256": "0afee0b29ee2c71933c5a83a60023e82db91c4f9db8f47d1f55b4b00f8108ba2",
      "text": "Choix de référence enregistré dans le plan de culture de cet appareil. Ceci ne confirme aucun pays d’exploitation ni aucune approbation agricole locale.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "WorkspaceReferencePanel.004",
      "sourceEnglish": "The reference choice could not be removed. Please try again.",
      "sourceSha256": "8776ea386edb982d3cff48813b63fb08fef7c18471dd2ddabb7cfe2c6190c705",
      "text": "Impossible de supprimer le choix de référence. Veuillez réessayer.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "WorkspaceReferencePanel.005",
      "sourceEnglish": "Reference choice removed. Your saved sowing entries remain in the crop plan.",
      "sourceSha256": "1e48830dc18eeac95220b0be244bb9e3a9b46fae06d7629b91782bee23225cc2",
      "text": "Choix de référence supprimé. Vos entrées de semis enregistrées restent dans le plan de culture.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "WorkspaceReferencePanel.006",
      "sourceEnglish": "Planning without a mapped site",
      "sourceSha256": "3d06bc8746685ea2ec9843b76c6729d1acd4417338ac5f97da56976d4e16af44",
      "text": "Planification sans site cartographié",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "WorkspaceReferencePanel.007",
      "sourceEnglish": "The existing planner uses South African reference assumptions. You can explicitly use that reference basis for this unmapped workspace. It does not establish your farm’s country, local planting suitability or permission to grow a crop outside South Africa.",
      "sourceSha256": "9bcd95adb165ae04183796fbe4d334cce5515bf0a6060ccf70c1e9cb5c61c1a4",
      "text": "Le planificateur actuel utilise des hypothèses de référence sud-africaines. Vous pouvez utiliser explicitement cette base de référence pour cet espace de travail non cartographié. Cela ne détermine pas le pays de votre exploitation, l’adéquation de plantation locale ni l’autorisation de cultiver une espèce hors d’Afrique du Sud.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "WorkspaceReferencePanel.008",
      "sourceEnglish": "The choice stays with this device’s crop plan and this workspace only. It never applies to a mapped site, another workspace, currency, language or measurement units.",
      "sourceSha256": "491ea8b14a9ea58791ccc59a4252cbb25e6325883f1c0879a473c074c9dd9eb5",
      "text": "Ce choix reste associé uniquement au plan de culture de cet appareil et à cet espace de travail. Il ne s’applique jamais à un site cartographié, à un autre espace de travail, à une devise, à une langue ou à des unités de mesure.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "WorkspaceReferencePanel.009",
      "sourceEnglish": "Sample mode keeps this choice inside its temporary demonstration.",
      "sourceSha256": "b2586f68678a72cc6d45db3e498e24306fb10cdff5fd36f1ce01870a1a9f4a7d",
      "text": "Le mode exemple conserve ce choix dans le cadre de sa démonstration temporaire.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "WorkspaceReferencePanel.010",
      "sourceEnglish": "Open a local design or virtual-bed workspace to choose its reference basis.",
      "sourceSha256": "be07dfa67bbf400d232e864c13aa95b6646649d26d48e32cf4fdf4ac16ff471e",
      "text": "Ouvrez une conception locale ou un espace de travail de planche virtuelle pour choisir sa base de référence.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "WorkspaceReferencePanel.011",
      "sourceEnglish": "South African reference planning selected for this unmapped workspace.",
      "sourceSha256": "f51c479c1c2c4f9a6ace4fdff2b0abfb32d26c4c990ebce4210e17d6e0c4325d",
      "text": "Planification de référence sud-africaine sélectionnée pour cet espace de travail non cartographié.",
