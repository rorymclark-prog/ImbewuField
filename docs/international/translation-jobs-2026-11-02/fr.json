      "sourceEnglish": "Your seeds sown per tray (optional)",
      "sourceSha256": "f1c14c6b33239598867fcef4e2981243d99c8bb744e2efe2c0f93719570a28bb",
      "text": "Vos graines semées par plaque (facultatif)",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "NurseryPlanPanel.044",
      "sourceEnglish": "Use your observed usable seedling output for a tray, including nursery losses. Suitable for your multi-sown or pricked-out method; no extra germination or nursery-loss allowance is applied.",
      "sourceSha256": "b98b6639466a7d36eb542a6a4ba1fcb72ce9b06da9a0632d89e8a82e5361166a",
      "text": "Utilisez votre production observée de plantules utilisables par plaque, en incluant les pertes en pépinière. Adapté à votre méthode de multi-semis ou de repiquage ; aucune marge supplémentaire de germination ou de perte en pépinière n’est appliquée.",
      "review": {
        "status": "unreviewed"
      }
    },
    {
      "key": "NurseryPlanPanel.045",
      "sourceEnglish": "Your field survival (%, optional)",
      "sourceSha256": "9ed23664f5a4e5a0a083f2a93903e05bbbedca3bf98109a0f18e4041686b4ce1",
      "text": "Votre taux de survie au champ (%, facultatif)",
