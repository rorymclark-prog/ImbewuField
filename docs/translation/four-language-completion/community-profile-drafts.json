      "ve": "Lingedzani hafhu"
    },
    {
      "key": "communityLocationUnsupported",
      "english": "This device can't share a location.",
      "st": "Sesebediswa sena ha se kgone ho arolelana sebaka.",
      "ts": "Xitirhisiwa lexi a xi koti ku avelana ndhawu.",
      "ve": "Tshishumiswa itshi a tshi koni u kovhana fhethu."
    },
    {
      "key": "communityLocationDenied",
      "english": "Could not get your location — map visibility left off.",
      "st": "Ha ho a kgoneha ho fumana sebaka sa hao — ho bonahala mmapeng ho siilwe ho timilwe.",
      "ts": "A swi kotekanga ku kuma ndhawu ya wena — ku vonakala emepeni ku siyiwe ku timiwile.",
      "ve": "A zwo ngo konadzea u wana fhethu haṋu — u vhonala kha mapa ho siiwa ho dzimiwa."
    },
    {
      "key": "communityProfileSaveError",
      "english": "Could not save — try again.",
      "st": "Ha ho a kgoneha ho boloka — leka hape.",
      "ts": "A swi kotekanga ku hlayisa — ringeta nakambe.",
      "ve": "A zwo ngo konadzea u vhulunga — lingedzani hafhu."
    },
    {
      "key": "communityDeleteProfileConfirm",
      "english": "Delete your community profile? This removes your profile and map pin. Your board posts stay until you close them individually.",
      "st": "Hlakola profaele ya hao ya setjhaba? Sena se tlosa profaele ya hao le phini ya mmappa. Melaetsa ya hao botong e sala ho fihlela o e kwala ka bonngwe.",
      "ts": "Xana u lava ku susa phurofayili ya wena ya vaaki? Swi susa phurofayili ya wena ni mfungho wa mepe. Switiviso swa wena swa le bodweni swi sala ku fikela loko u swi pfala hi xin’we-xin’we.",
      "ve": "Ni ṱoḓa u bvisa phurofaiḽi yaṋu ya tshitshavha? Izwi zwi bvisa phurofaiḽi yaṋu na tshiga kha mapa. Milaedza yaṋu kha bodo i sala u swika ni tshi i vala nga muthihi nga muthihi."
    },
    {
      "key": "communityDeleteProfile",
      "english": "Delete my community profile",
      "st": "Hlakola profaele ya ka ya setjhaba",
      "ts": "Susa phurofayili ya mina ya vaaki",
      "ve": "Bvisani phurofaiḽi yanga ya tshitshavha"
    },
    {
      "key": "communityLoadingStatus",
      "english": "Loading community profile",
      "st": "Profaele ya setjhaba e a kenngwa…",
      "ts": "Phurofayili ya vaaki ya layicha…",
      "ve": "Phurofaiḽi ya tshitshavha i khou laisiwa…"
