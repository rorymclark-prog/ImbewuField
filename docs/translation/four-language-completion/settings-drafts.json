    {
      "key": "settingsShowAmount",
      "english": "How much to show",
      "zu": "Kuboniswe okungakanani",
      "st": "Ho bontshwe bokae",
      "ts": "Ku kombisiwa swo tala ku fikela kwihi",
      "ve": "Hu sumbedzwe zwingafhani"
