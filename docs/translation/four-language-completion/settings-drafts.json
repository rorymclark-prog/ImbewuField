    {
      "key": "settingsSubtitle",
      "english": "Language, text size & theme",
      "zu": "Ulimi, usayizi wombhalo nombala wohlelo",
      "st": "Puo, boholo ba mongolo le mebala",
      "ts": "Ririmi, vukulu bya matsalwa ni mivala",
      "ve": "Luambo, vhuhulwane ha maṅwalwa na mivhala"
    },
    {
      "key": "settingsClose",
      "english": "Close settings",
      "zu": "Vala izilungiselelo",
      "st": "Kwala ditlhophiso",
      "ts": "Pfala swiyimiso",
      "ve": "Valani nzudzanyo"
