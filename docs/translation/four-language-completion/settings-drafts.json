    {
      "key": "settingsDataNote",
      "english": "Farm guidance is built from South African climate, soil and terrain data.",
      "zu": "Amasu ezolimo asekelwe ku-climate, inhlabathi kanye nedatha yendawo yaseNingizimu Afrika.",
      "st": "Tataiso ya temo e thehilwe ho data ya boemo ba lehodimo, mobu le sebopeho sa naha ya Afrika Borwa.",
      "ts": "Nkongomiso wa vurimi wu sekeriwe eka datha ya maxelo, misava ni xivumbeko xa misava ya Afrika Dzonga.",
      "ve": "Vhulivhisi ha vhulimi ho bveledzwa nga data ya mutsho, mavu na mbumbo ya mavu a Afrika Tshipembe."
    },
    {
      "key": "settingsSavedAutomatically",
      "english": "ImbewuField · saved automatically",
      "zu": "ImbewuField · kulondolozwa ngokuzenzakalelayo",
      "st": "ImbewuField · e bolokwa ka boyona",
      "ts": "ImbewuField · swi hlayisiwa hi swoxe",
      "ve": "ImbewuField · zwi vhulungwa nga zwoṱhe"
    },
    {
      "key": "settingsAiTitle",
      "english": "Paid AI features",
      "zu": "Amathuluzi e-AI akhokhelwayo",
      "st": "Dithulusi tsa AI tse lefellwang",
      "ts": "Switirhisiwa swa AI leswi hakeriwaka",
      "ve": "Zwishumiswa zwa AI zwi badelwaho"
    },
    {
      "key": "settingsAiDescription",
      "english": "Choose which AI tools this account can use on this device. Typing, phone dictation, photos and saving records still work when AI is off.",
      "zu": "Khetha amathuluzi e-AI le akhawunti engawasebenzisa kule divayisi. Ukuthayipha, ukubiza umbhalo ngocingo, izithombe nokulondoloza amarekhodi kusasebenza noma i-AI ivaliwe.",
      "st": "Kgetha dithulusi tsa AI tseo akhaonto ena e ka di sebedisang sesebedisweng sena. Ho thaepa, ho bua hore fono e ngole, dinepe le ho boloka ditlaleho di ntse di sebetsa ha AI e timilwe.",
      "ts": "Hlawula switirhisiwa swa AI leswi akhawunti leyi yi nga swi tirhisaka eka xitirhisiwa lexi. Ku thayipa, ku vula marito leswaku riqingho ri tsala, swifaniso ni ku hlayisa tirhekhodo swa ha tirha loko AI yi timiwile.",
      "ve": "Khethani zwishumiswa zwa AI zwine akhaunthu iyi ya nga zwi shumisa kha tshishumiswa itshi. U thaipha, u amba uri founu i ṅwale, zwifanyiso na u vhulunga rekhodo zwi kha ḓi shuma musi AI yo tsimiwa."
    },
    {
      "key": "settingsAiAllowAll",
