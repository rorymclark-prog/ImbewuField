    {
      "key": "settingsSimple",
      "english": "Simple",
      "zu": "Okulula",
      "st": "E bonolo",
      "ts": "Swo olova",
      "ve": "Zwo leluwaho"
    },
    {
      "key": "settingsSimpleDesc",
      "english": "The main jobs only. Best when you are starting out.",
      "zu": "Imisebenzi eyinhloko kuphela. Kuhle uma usaqala.",
      "st": "Mesebetsi ya bohlokwa feela. E loketse ha o sa qala.",
      "ts": "Mintirho-nkulu ntsena. Swi lulamile loko wa ha sungula.",
      "ve": "Mishumo ya ndeme fhedzi. Zwo tea musi ni tshi kha ḓi thoma."
    },
    {
      "key": "settingsAllTools",
      "english": "All tools",
      "zu": "Wonke amathuluzi",
      "st": "Dithulusi tsohle",
      "ts": "Switirhisiwa hinkwato",
      "ve": "Zwishumiswa zwoṱhe"
    },
    {
      "key": "settingsAllToolsDesc",
      "english": "Everything, including every planning and money tool.",
      "zu": "Konke, kuhlanganise wonke amathuluzi okuhlela nawemali.",
      "st": "Tsohle, ho kenyeletswa dithulusi tsohle tsa ho rala le tsa ditjhelete.",
      "ts": "Hinkwako, ku katsa switirhisiwa swo kunguhata ni swa mali.",
      "ve": "Zwoṱhe, hu tshi katelwa zwishumiswa zwoṱhe zwa u pulana na zwa tshelede."
    },
    {
      "key": "settingsChangeAnyTime",
      "english": "You can change this any time.",
      "zu": "Ungakushintsha noma nini.",
      "st": "O ka fetola sena neng kapa neng.",
      "ts": "U nga cinca leswi nkarhi wihi na wihi.",
      "ve": "Ni nga shandula izwi tshifhinga tshiṅwe na tshiṅwe."
    },
