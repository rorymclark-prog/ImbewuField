  {
   "id": "H-A",
   "rule": "A place on the hot, frost-free calendar ('all-year') must have no air-frost day in the 20 years and a lowest daily minimum above 0 C."
  },
  {
   "id": "H-B",
   "rule": "A place on the light-frost calendar ('mild-frost') must average fewer than 0.5 air-frost days a year."
  },
  {
   "id": "H-C",
   "rule": "A place averaging 1 or more air-frost days a year must be on 'summer' (hard frost) or 'winter' (Western Cape)."
  },
  {
   "id": "H-D",
   "rule": "A place with no frost year, a lowest daily minimum above 0 C and an app record minimum above 0 C must not be on 'summer'."
  }
 ],
