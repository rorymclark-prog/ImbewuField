# ImbewuField — environment variables
# Copy this file to .env.local for local dev, and set the SAME keys in
# Vercel → Project → Settings → Environment Variables for the live site.
# NEVER commit real values — this file holds placeholders only.

# ── Mapbox (REQUIRED for the map to display) ────────────────────────────────
# Without this the map area is BLANK while the buttons still show.
# Get it from https://account.mapbox.com/access-tokens (starts with "pk.").
# In Mapbox, allow your domains under the token's URL restrictions
# (fieldproof.vercel.app and permamap-sa.vercel.app) — or use no restriction.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# ── Esri World Imagery (OPTIONAL — sharper aerial photo on plan sheets) ─────
# Mapbox has no real imagery over most rural South Africa, so plan sheets fall back to an
# upsampled, unreadable smear. Esri's World Imagery has real detail to z18 over the same
# ground. Leave this UNSET and nothing changes — sheets keep using Mapbox exactly as before.
# Get a free key at https://location.arcgis.com/ (ArcGIS Location Platform sign-up). Its free
# tier includes 2,000,000 basemap tiles/month; a plan frame costs ~4 tiles, so that is on the
# order of half a million plans a month. Setting this key is commercial-use licensed — do NOT
# point this at server.arcgisonline.com or any other unauthenticated Esri endpoint instead.
NEXT_PUBLIC_ARCGIS_API_KEY=

# ── Anthropic (REQUIRED for AI features: reports, photo analysis, insights) ──
# Get it from https://console.anthropic.com/ (starts with "sk-ant-").
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Firebase (REQUIRED for login, data, photo storage) ──────────────────────
# From Firebase console → Project settings → General → Your apps → SDK config.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Site gate password (REQUIRED — guards the whole site) ────────────────────
# Any value you choose; visitors must enter it to get in.
SITE_PASSWORD=choose-a-password

# ── Seed script only (not needed for the running app) ───────────────────────
# Path to the Firebase service-account JSON. Defaults to ./serviceAccount.json.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
