# ImbewuField — local Firebase emulator mode
#
# Runs the app fully locally (fake auth + local Firestore) with ZERO traffic
# to the production Firebase project (fieldproof-sa). Safe for automated
# product walkthroughs and demo seeding.
#
# This file is a reference — copy the line(s) you need into your shell, or
# into a separate untracked env file. Do NOT add these to .env.local (that
# file is the real production config and must stay untouched).
#
# ── Usage ────────────────────────────────────────────────────────────────
#
#   1. Start the emulators (Auth + Firestore only — no Storage needed):
#        firebase emulators:start --only auth,firestore --project fieldproof-sa
#
#   2. Seed a test user + minimal farmer profile into the EMULATOR only
#      (never touches production — do NOT run scripts/seed.mjs for this):
#        node scripts/seed-emulator.mjs
#
#   3. Start the dev server with the emulator flag set:
#        NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1 npx next dev -p 4243
#
# The flag is read in lib/firebase/init.ts. When it is unset (the default,
# and always the case in any real `.env.local` / Vercel deploy), production
# behaviour is byte-for-byte unchanged — no emulator code path is touched.

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1

# ── Emulator ports (fixed — must match firebase.json "emulators" block) ───
# Auth:      127.0.0.1:9099
# Firestore: 127.0.0.1:8080
# Emulator UI (optional, browse data at http://127.0.0.1:4000): 4000

# ── Seeded test user (created by scripts/seed-emulator.mjs) ───────────────
# Email:    test@imbewufield.local
# Password: testpass123
# Role:     farmer
